# Copy to .env and fill in. .env is git-ignored: never commit a real key.
# The three LLM_* variables select the model endpoint.

# --- Mode 1: local, on-premise / air-gapped (GPU workstation, e.g. RTX 5090) -------
# Official Apertus 1.5 vLLM image, full multimodal model (text + images).
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=http://llm:8000/v1
LLM_API_KEY=local
# Needed once at build/download time only (the HF model repo is gated):
# HF_TOKEN=

# --- Mode 2: sovereign Swiss cloud (Phoeniqs / kvant) -----------
# LLM_NAME=inference-apertus-v15-70b
# LLM_BASE_URL=https://maas.phoeniqs.com/v1
# LLM_API_KEY=

# --- Mode 2b: CSCS --------------------------------------------------
# LLM_NAME=swiss-ai/Apertus-v1.5-70B
# LLM_BASE_URL=https://api.inference.cscs.ch/v1
# LLM_API_KEY=

# --- Mode 3: CPU-only fallback, text criteria only (llama.cpp + GGUF) ---------------
# LLM_NAME=swiss-ai/Apertus-v1.5-8B
# LLM_BASE_URL=http://llm-cpu:8080/v1
# LLM_API_KEY=local
