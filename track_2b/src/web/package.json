{
  "name": "klar-web",
  "private": true,
  "version": "0.1.0",
  "description": "Klar. web UI: meaning checks for an accessible Swiss web (Vue 3 + Vite).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "typecheck": "vue-tsc --noEmit",
    "check": "vue-tsc --noEmit && node scripts/unit.mjs && node scripts/contract.mjs && vite build && node scripts/check-build.mjs",
    "check:build": "node scripts/check-build.mjs",
    "contract": "node scripts/contract.mjs",
    "a11y": "node scripts/a11y.mjs",
    "preview": "vite preview --outDir ../klar/api/static",
    "preview:demo": "vite preview --outDir dist-demo",
    "test:unit": "node scripts/unit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lucide/vue": "1.48.0",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "axe-core": "4.11.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.12"
  }
}
